{
  // Type-checks a client of the package against the published declarations,
  // importing it by name as a client would.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"]
  },
  "include": ["client.ts"]
}
