{
  "name": "gencmu",
  "version": "0.1.0",
  "description": "A Lojban parser whose grammars are literate documents loaded at runtime",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gencmu": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./src/node.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "cli.js",
    "src",
    "types",
    "grammars"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "types": "tsc -p .",
    "check-types": "tsc -p . --noEmit && tsc -p typecheck"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
