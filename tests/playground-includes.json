  {
    "description": "The editor uses a decoded numeric include path.",
    "sources": {
      "p.md": "```jbogenbau\n%stage main\n%ambiguity-resolution greedy\n%include \"g‹U+002E›md\"\n```\n",
      "g.md": "```jbogenbau\n%rule text \"a\"\n```\n"
    },
    "documents": [
      "p.md",
      "g.md"
    ]
  },
  {
    "description": "The editor uses inherited names and preserves literal path runs.",
    "sources": {
      "p.md": "```jbogenbau\n%names \"extra.txt\"\n%stage main\n%ambiguity-resolution greedy\n%include \"wrapper.md\"\n```\n",
      "wrapper.md": "```jbogenbau\n%include \"é‹EDITOR LETTER›.md\"\n```\n",
      "é.md": "```jbogenbau\n%rule text \"a\"\n```\n",
      "extra.txt": "unicode-names 15.1.0\nname E000 EDITOR LETTER\n"
    },
    "documents": [
      "p.md",
      "wrapper.md",
      "é.md"
    ]
  },
  {
    "description": "The editor uses a core abbreviation in an include path.",
    "sources": {
      "p.md": "```jbogenbau\n%stage main\n%ambiguity-resolution greedy\n%include \"g‹HT›.md\"\n```\n",
      "g\t.md": "```jbogenbau\n%rule text \"a\"\n```\n"
    },
    "documents": [
      "p.md",
      "g\t.md"
    ]
  },
  {
    "description": "Repeated documents retain each inherited names scope in the editor.",
    "sources": {
      "p.md": "```jbogenbau\n%stage main\n%ambiguity-resolution greedy\n%include \"left.md\"\n%include \"right.md\"\n```\n",
      "left.md": "```jbogenbau\n%names \"left.txt\"\n%include \"shared.md\"\n```\n",
      "right.md": "```jbogenbau\n%names \"right.txt\"\n%include \"shared.md\"\n```\n",
      "shared.md": "```jbogenbau\n%include \"‹LOCAL PATH›.md\"\n```\n",
      "left.txt": "unicode-names 15.1.0\nname E000 LOCAL PATH\n",
      "right.txt": "unicode-names 15.1.0\nname E001 LOCAL PATH\n",
      ".md": "```jbogenbau\n%rule text \"a\"\n```\n",
      ".md": "```jbogenbau\n%extend-rule text \"b\"\n```\n"
    },
    "documents": [
      "p.md",
      "left.md",
      "shared.md",
      ".md",
      "right.md",
      ".md"
    ],
    "stages": [
      {
        "name": "main",
        "documents": [
          "left.md",
          "shared.md",
          ".md",
          "right.md",
          "shared.md",
          ".md"
        ]
      }
    ]
  }
]
