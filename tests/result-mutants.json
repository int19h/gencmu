{
  "description": "Changes to a canonical result that break an invariant of the result (tests/README.md, \"Result mutants\"). Every runner applies each to the result of its engine case and requires that its checks refuse it.",
  "mutants": [
    {
      "name": "an ambiguous error with a token",
      "case": "attach-tie.json",
      "path": [
        "error",
        "token"
      ],
      "set": 0
    },
    {
      "name": "an ambiguous error with a source",
      "case": "attach-tie.json",
      "path": [
        "error",
        "source"
      ],
      "set": [
        0,
        1
      ]
    },
    {
      "name": "an elision-only error with a token",
      "case": "elision-only-warnings.json",
      "path": [
        "error",
        "token"
      ],
      "set": 0
    },
    {
      "name": "an elision-only error with a source",
      "case": "elision-only-warnings.json",
      "path": [
        "error",
        "source"
      ],
      "set": [
        0,
        1
      ]
    },
    {
      "name": "a tree beside the tie",
      "case": "attach-tie.json",
      "path": [
        "tree"
      ],
      "copy": [
        "error",
        "readings",
        0
      ]
    },
    {
      "name": "one reading",
      "case": "attach-tie.json",
      "path": [
        "error",
        "readings"
      ],
      "keep": 1
    },
    {
      "name": "an ok result",
      "case": "attach-tie.json",
      "path": [
        "ok"
      ],
      "set": true
    },
    {
      "name": "an error of another kind",
      "case": "attach-tie.json",
      "path": [
        "error",
        "kind"
      ],
      "set": "rejected"
    },
    {
      "name": "an error of another stage",
      "case": "attach-tie.json",
      "path": [
        "error",
        "stage"
      ],
      "set": "another"
    },
    {
      "name": "an error of another reason",
      "case": "attach-tie.json",
      "path": [
        "error",
        "reason"
      ],
      "set": "elision-only"
    },
    {
      "name": "an error without a reason",
      "case": "attach-tie.json",
      "path": [
        "error",
        "reason"
      ],
      "remove": true
    },
    {
      "name": "no error",
      "case": "attach-tie.json",
      "path": [
        "error"
      ],
      "set": null
    },
    {
      "name": "a tied stage with output",
      "case": "attach-tie.json",
      "path": [
        "stages",
        -1,
        "output"
      ],
      "set": []
    },
    {
      "name": "a stage with a tied tree",
      "case": "attach-tie.json",
      "path": [
        "stages",
        -1,
        "tied"
      ],
      "copy": [
        "error",
        "readings",
        1
      ]
    },
    {
      "name": "a stage after the tie",
      "case": "attach-tie.json",
      "path": [
        "stages"
      ],
      "append": {
        "name": "later",
        "verdict": "unique"
      }
    },
    {
      "name": "error member cycle",
      "case": "late-elision-roots-tie.json",
      "path": [
        "error",
        "cycle"
      ],
      "set": []
    },
    {
      "name": "error member conflict",
      "case": "late-elision-roots-tie.json",
      "path": [
        "error",
        "conflict"
      ],
      "set": {}
    },
    {
      "name": "error member chosenReading",
      "case": "late-elision-roots-tie.json",
      "path": [
        "error",
        "chosenReading"
      ],
      "set": 0
    },
    {
      "name": "a reported failure without its tree",
      "case": "i276-error-shape.json",
      "path": [
        "tree"
      ],
      "set": null
    },
    {
      "name": "a reported failure with no errors",
      "case": "i276-error-shape.json",
      "path": [
        "error",
        "errors"
      ],
      "set": []
    },
    {
      "name": "a reported failure with a tied verdict",
      "case": "i276-error-shape.json",
      "path": [
        "stages",
        0,
        "verdict"
      ],
      "set": "tie"
    },
    {
      "name": "a reported failure without output",
      "case": "i276-error-shape.json",
      "path": [
        "stages",
        0,
        "output"
      ],
      "remove": true
    },
    {
      "name": "a reported failure with an envelope source",
      "case": "i276-error-shape.json",
      "path": [
        "error",
        "source"
      ],
      "set": [
        0,
        1
      ]
    },
    {
      "name": "a named error with another stage",
      "case": "i276-error-shape.json",
      "path": [
        "error",
        "errors",
        0,
        "stage"
      ],
      "set": "other"
    },
    {
      "name": "a named error with another rule",
      "case": "i276-error-shape.json",
      "path": [
        "error",
        "errors",
        0,
        "rule"
      ],
      "set": "other"
    },
    {
      "name": "a named error with a warning feature",
      "case": "i276-error-shape.json",
      "path": [
        "error",
        "errors",
        0,
        "feature"
      ],
      "set": "bad"
    },
    {
      "name": "a warning without its message",
      "case": "warning-on.json",
      "path": [
        "warnings",
        0,
        "message"
      ],
      "remove": true
    },
    {
      "name": "an emitted carrier with an empty error list",
      "case": "deferred-report-forward.json",
      "path": [
        "stages",
        0,
        "output",
        0,
        "errors"
      ],
      "set": []
    },
    {
      "name": "stage-level errors beside nonempty output",
      "case": "deferred-report-forward.json",
      "path": [
        "stages",
        0,
        "errors"
      ],
      "copy": [
        "stages",
        0,
        "output",
        0,
        "errors"
      ]
    },
    {
      "name": "a failed envelope without its collected warnings",
      "case": "deferred-report-rejection-cutoff.json",
      "path": [
        "error",
        "warnings"
      ],
      "remove": true
    }
  ]
}
