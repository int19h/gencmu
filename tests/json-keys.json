{
  "values": [
    {
      "description": "Exact keys differ by case",
      "json": "{\"name\":1,\"Name\":2}",
      "expect": {
        "name": 1,
        "Name": 2
      }
    },
    {
      "description": "The last exact key wins",
      "json": "{\"name\":1,\"Name\":2,\"name\":3}",
      "expect": {
        "name": 3,
        "Name": 2
      }
    },
    {
      "description": "An escaped key names the same member",
      "json": "{\"name\":1,\"na\\u006de\":3}",
      "expect": {
        "name": 3
      }
    },
    {
      "description": "An escaped capital remains distinct",
      "json": "{\"name\":1,\"\\u004eame\":3}",
      "expect": {
        "name": 1,
        "Name": 3
      }
    },
    {
      "description": "Duplicate objects replace rather than merge",
      "json": "{\"x\":{\"a\":1},\"x\":{\"b\":2}}",
      "expect": {
        "x": {
          "b": 2
        }
      }
    },
    {
      "description": "A duplicate null replaces its old value",
      "json": "{\"x\":1,\"x\":null}",
      "expect": {
        "x": null
      }
    },
    {
      "description": "Duplicates inside arrays use the same rule",
      "json": "[{\"x\":1,\"x\":2},{\"X\":1,\"x\":2}]",
      "expect": [
        {
          "x": 2
        },
        {
          "X": 1,
          "x": 2
        }
      ]
    }
  ],
