{
  "description": "Every NFD_Quick_Check value normalizes aliases through terminals, tests, patterns, conditions, filters, and caller tags.",
  "grammar": "%rule text r0 r1\n%rule r0 $x:_NFD_Quick_Check_No<_NFD_Quick_Check_No>\n%conditions $x ≅ #_NFD_Quick_Check_No<_NFD_Quick_Check_No>, _NFD_Quick_Check_No ⊆ $x.tags\n%emits $x :: $x.tags ∩ _NFD_Quick_Check_No\n%rule r1 $x:_NFD_Quick_Check_Yes<_NFD_Quick_Check_Yes>\n%conditions $x ≅ #_NFD_Quick_Check_Yes<_NFD_Quick_Check_Yes>, _NFD_Quick_Check_Yes ⊆ $x.tags\n%emits $x :: $x.tags ∩ _NFD_Quick_Check_Yes",
  "tokens": [
    {
      "text": "x",
      "value": "different",
      "tags": [
        "_NFD_QC_N",
        "_NFD_Quick_Check_No"
      ]
    },
    {
      "text": "x",
      "value": "different",
      "tags": [
        "_NFD_QC_Y",
        "_NFD_Quick_Check_Yes"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "tags": [
                "_NFD_Quick_Check_No"
              ]
            },
            {
              "tags": [
                "_NFD_Quick_Check_Yes"
              ]
            }
          ]
        }
      ],
      "tree": {
        "children": [
          {
            "rule": "r0",
            "children": [
              {
                "terminal": "_NFD_Quick_Check_No"
              }
            ],
            "tags": [
              "_NFD_Quick_Check_No"
            ]
          },
          {
            "rule": "r1",
            "children": [
              {
                "terminal": "_NFD_Quick_Check_Yes"
              }
            ],
            "tags": [
              "_NFD_Quick_Check_Yes"
            ]
          }
        ]
      }
    }
  }
}
