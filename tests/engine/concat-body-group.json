{
  "description": "A string constant supplies the terminal.",
  "grammar": "%const $A \"a\"\n%const $B \"b\"\n%const $JOIN-1 ($A ++ \"\") ++ ($B ++ \"\")\n%rule text ($JOIN-1) %emits",
  "tokens": [
    {
      "text": "x",
      "value": "ab",
      "tags": [
        "T"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "value": "ab"
            }
          ]
        }
      ]
    }
  }
}
