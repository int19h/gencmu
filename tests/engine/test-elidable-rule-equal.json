{
  "description": "An = test on a rule reference makes a plain optional, never an elidable one, whatever a marker on a terminal of the same name says. An absent [x=\"\"] is no elided node, while an absent [+~x] is one (engine §2, §3.8).",
  "grammar": "%rule text [x=\"\"] [+~x] B\n%rule x A",
  "tokens": [
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "verdict": "unique"
        }
      ],
      "tree": {
        "rule": "text",
        "children": [
          {
            "kind": "elided",
            "terminal": "x",
            "span": [
              0,
              0
            ]
          },
          {
            "kind": "token",
            "terminal": "B"
          }
        ]
      }
    }
  }
}
