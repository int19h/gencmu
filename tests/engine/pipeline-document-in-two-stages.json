{
  "description": "A document may be included in two stages: common.md gives each stage its %ambiguity-resolution, and each stage's items are its own (engine §13).",
  "documents": {
    "p.md": "```jbogenbau\n%stage sounds\n%include \"common.md\"\n%include \"g.md\"\n%stage words\n%include \"common.md\"\n%include \"h.md\"\n```\n",
    "common.md": "```jbogenbau\n%ambiguity-resolution greedy\n```\n",
    "g.md": "```jbogenbau\n%rule text [c] ...\n%rule c \"a\" </a/> %emits $\n```\n",
    "h.md": "```jbogenbau\n%rule text /a/ /a/\n```\n"
  },
  "pipeline": "p.md",
  "input": "aa",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "sounds",
          "verdict": "unique"
        },
        {
          "name": "words",
          "verdict": "unique"
        }
      ]
    }
  }
}
