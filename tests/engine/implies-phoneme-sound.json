{
  "description": "An implication adds the ordinary Sound-006F-s tag to an emitted token but does not change its value x (engine §11.1).",
  "grammar": "%implies A ⟹ Sound-006F-s\n%rule text [{word}]\n%rule word $w:W :: ($w.tags ∪ A) %emits $\n\n",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "W"
      ],
      "value": "x"
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "main",
          "output": [
            {
              "text": "x",
              "value": "x",
              "tags": [
                "A",
                "Sound-006F-s",
                "W"
              ]
            }
          ]
        }
      ]
    }
  }
}
