{
  "description": "One loaded grammar keeps feature-dependent answers separate across repeated parses (engine §4 and §10).",
  "grammar": "%rule text $x(candidate)\n%conditions matches(without-elision($x), rival)\n%rule candidate X [+T]\n%rule rival ¬f? X [+T] | f? X [+U]",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ],
      "phonemes": "x"
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  },
  "parses": [
    {
      "options": {},
      "expect": {
        "result": {
          "ok": true
        }
      }
    },
    {
      "options": {
        "features": [
          "f"
        ]
      },
      "expect": {
        "error": "rejected",
        "result": {
          "ok": false
        }
      }
    },
    {
      "options": {},
      "expect": {
        "result": {
          "ok": true
        }
      }
    }
  ]
}
