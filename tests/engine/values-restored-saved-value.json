{
  "description": "Aligned queries keep close identity and ignore saved recognition values on synthetic tests (engine §7).",
  "grammar": "%rule text $c:c %conditions $c.without-elision.matches(r)\n%rule c X [+T=\"v\"] :: ∅\n%rule r X [+T=\"q\"] :: ∅",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ]
    }
  ],
  "expect": {
    "result": {
      "format": 14,
      "ok": true,
      "tree": {
        "children": [
          {
            "rule": "c",
            "children": [
              {
                "terminal": "X"
              },
              {
                "kind": "elided",
                "terminal": "T",
                "value": "v"
              }
            ]
          }
        ]
      }
    }
  }
}
