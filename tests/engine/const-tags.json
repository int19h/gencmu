{
  "description": "A tag-set constant stands in a tag term and in a condition (engine §2, §10).",
  "grammar": "%const $MARKS (Word ∪ C)\n%rule text $w:word %conditions $MARKS ⊆ $w.tags, ($w.tags ∩ $MARKS) ≠ ∅\n\n%rule word A :: $MARKS",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "rule",
            "rule": "word",
            "tags": [
              "C",
              "Word"
            ]
          }
        ]
      }
    }
  }
}
