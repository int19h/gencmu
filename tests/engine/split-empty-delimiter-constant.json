{
  "description": "An empty delimiter that is a constant is an error of the document, which the loader reports at the constant (engine §2, §10).",
  "grammar": "%const $D \"\"\n%rule text $x:A %conditions \"a\" ∈ $x.value.split($D)\n",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "A"
      ],
      "value": "a"
    }
  ],
  "expect": {
    "error": "grammar",
    "where": {
      "document": "main.md",
      "line": 4,
      "column": 50
    }
  }
}
