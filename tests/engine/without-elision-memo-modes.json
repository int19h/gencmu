{
  "description": "Ordinary and aligned requests over equal words keep different answers (engine §4 and §10).",
  "grammar": "%rule text $x:candidate %conditions $x.matches(rival), ¬($x.without-elision.matches(rival))\n\n%rule candidate (X [+T])\n%rule rival (X [+U])",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ],
      "value": "x"
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
