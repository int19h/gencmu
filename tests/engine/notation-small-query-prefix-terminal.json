{
  "description": "Engine §4 distinguishes a terminal prefix match from a whole-span terminal match.",
  "grammar": "%rule text $x:pair %conditions ($x.parse(C …) ∨ $x.parse(A …)), ¬($x.parse(C) ∨ $x.parse(A))\n%rule pair A B",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    },
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
