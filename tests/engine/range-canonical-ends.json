{
  "description": "A range's terminal identity uses canonical scalar-string endpoints. The canonical tree escapes combining-mark endpoints with engine scalar concatenation (engine §4, docs/output.md).",
  "grammar": "%rule text (\"a\"..\"z\" \"̀\"..\"ͯ\" \"x\"..\"z\")",
  "input": "b́y",
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "token",
            "terminal": "\"a\"..\"z\""
          },
          {
            "kind": "token",
            "terminal": "$_0300..$_036F"
          },
          {
            "kind": "token",
            "terminal": "\"x\"..\"z\""
          }
        ]
      }
    }
  }
}
