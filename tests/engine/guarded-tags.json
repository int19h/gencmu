{
  "description": "A guarded tag term gives its tags where its condition holds and none where it does not (engine §10).",
  "grammar": "%rule text (x x)\n%rule x :: (X ⊆ $a.tags ⟹ Y) | $a:A\n",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A",
        "X"
      ]
    },
    {
      "text": "b",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "rule",
            "rule": "x",
            "tags": [
              "Y"
            ]
          },
          {
            "kind": "rule",
            "rule": "x",
            "tags": []
          }
        ]
      }
    }
  }
}
