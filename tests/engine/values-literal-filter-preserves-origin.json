{
  "description": "A complete filter retains borrowed tag origin and permits stored engine tags (engine §1).",
  "grammar": "%rule text $x:X :: $x.tags ∩ _Lu",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X",
        "_General_Category_Uppercase_Letter"
      ]
    }
  ],
  "expect": {
    "result": {
      "format": 15,
      "ok": true,
      "tree": {
        "tags": [
          "_General_Category_Uppercase_Letter"
        ]
      }
    }
  }
}
