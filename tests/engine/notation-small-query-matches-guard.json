{
  "description": "Query target choices also work inside guarded tag terms.",
  "grammar": "%rule text A :: ($.matches(B | A) \u27f9 Good) %emits $",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "tags": [
          "Good"
        ]
      }
    }
  }
}
