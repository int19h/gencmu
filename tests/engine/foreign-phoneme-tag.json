{
  "description": "A token with its own phoneme tag sounds like that phoneme and has it as its label, even over a foreign part. The part still gives the token its source and text (engine §5, §11).",
  "grammar": "%rule text [piece] ...\n%rule piece word | '\\p{White_Space}'\n%rule word 'a' | word 'a'\n%emits $ <W ∪ /a/>\n%foreign",
  "input": "aa aaa",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "text": "aa",
              "phonemes": "a",
              "label": "a",
              "span": [
                0,
                2
              ],
              "source": [
                0,
                2
              ]
            },
            {
              "text": "aaa",
              "phonemes": "a",
              "label": "a",
              "span": [
                3,
                6
              ],
              "source": [
                3,
                6
              ]
            }
          ]
        }
      ]
    }
  }
}
