{
  "description": "Engine §11.3 joins captured values and literals with ++ in a header image recipe.",
  "grammar": "%const $S \"b\"\n%rule text :- $a.value ++ \"-\" ++ \"x\"\n  | $a:\"x\"\n%emits",
  "input": "x",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "main",
          "output": [
            {
              "value": "x",
              "image": "x-x"
            }
          ]
        }
      ]
    }
  }
}
