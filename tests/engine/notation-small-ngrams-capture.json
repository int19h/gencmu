{
  "description": "Engine §10 converts a captured input value to a string before computing its n-grams.",
  "grammar": "%rule text $x:_ %conditions $x.ngrams(2) = (\"ab\" \"bc\"), $x.value.ngrams(2) ⊆ (\"ab\" \"bc\" \"cd\")",
  "tokens": [
    {
      "text": "x",
      "value": "abc",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
