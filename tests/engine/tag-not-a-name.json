{
  "description": "tag() of a string that is not a name is an error of the grammar when a parse evaluates it (engine §10, §13).",
  "grammar": "%rule text $w:word\n%rule word $y:A :: $y.source-text.tag",
  "tokens": [
    {
      "text": "ko'a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "error": "grammar",
    "where": {
      "document": "main.md",
      "line": 4,
      "column": 20
    }
  }
}
