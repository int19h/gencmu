{
  "description": "A ≠ test on a rule reference is no error, since [x≠\"a\"] is a plain optional of the rule x and not of the terminal ~x. An absent [x≠\"a\"] is no elided node, while an absent [+~x] is one (engine §2, §3.8).",
  "grammar": "%rule text [x≠\"a\"] [+~x] B\n%rule x A",
  "tokens": [
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "verdict": "unique"
        }
      ],
      "tree": {
        "rule": "text",
        "children": [
          {
            "kind": "elided",
            "terminal": "x",
            "span": [
              0,
              0
            ]
          },
          {
            "kind": "token",
            "terminal": "B"
          }
        ]
      }
    }
  }
}
