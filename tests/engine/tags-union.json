{
  "description": "A constituent's tags are the union of its alternative's own and the rule's %tags; with either written, the single symbol's tags are not its default (engine §3.7).",
  "grammar": "%rule text x x\n%rule x A <\"one\"> | B\n%tags \"rule\"",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    },
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "rule",
            "rule": "x",
            "tags": {
              "one": true,
              "rule": true
            }
          },
          {
            "kind": "rule",
            "rule": "x",
            "tags": {
              "rule": true
            }
          }
        ]
      }
    }
  }
}
