{
  "description": "Guard lowering retains the surrounding set operators.",
  "grammar": "%rule text left right\n%rule left A :: (Base ∪ ($.followed-by(right) ⟹ Mark)) ∖ Base\n%rule right B",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    },
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "children": [
          {
            "rule": "left",
            "tags": [
              "Mark"
            ]
          },
          {
            "rule": "right"
          }
        ]
      }
    }
  }
}
