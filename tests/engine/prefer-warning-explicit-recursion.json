{
  "description": "Preference diagnostics count original construction sites and conservative same-span paths.",
  "grammar": "%ambiguity-resolution late-elision\n%rule text a | b\n%rule a X | X a\n%rule b X\n%prefer a > b",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ]
    }
  ],
  "expect": {
    "loadWarnings": [
      {
        "kind": "prefer-multiple-references",
        "stage": "main",
        "rule": "a",
        "references": [
          {
            "document": "case/main.md",
            "at": [
              4,
              1
            ],
            "rule": "a",
            "alternative": 1,
            "path": "/seq/1"
          },
          {
            "document": "case/main.md",
            "at": [
              3,
              1
            ],
            "rule": "text",
            "alternative": 0,
            "path": ""
          }
        ]
      }
    ]
  }
}
