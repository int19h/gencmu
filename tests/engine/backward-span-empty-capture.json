{
  "description": "An empty capture retains its position for a preceding span. (Engine §4.4.)",
  "grammar": "%rule text A $x:nothing B\n%conditions $x.preceding-tokens.value = \"a\"\n%rule nothing \u03b5",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    },
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
