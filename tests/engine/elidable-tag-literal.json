{
  "description": "An elidable optional's terminator can be a tag literal: [+~ku] marks the terminal ku, and [+~KU] and [+KU] mark one terminal (design §15, engine §3.8).",
  "grammar": "%rule text A [+~ku] [+KU]",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "token",
            "terminal": "A",
            "token": 0
          },
          {
            "kind": "elided",
            "terminal": "ku",
            "span": [
              1,
              1
            ]
          },
          {
            "kind": "elided",
            "terminal": "KU",
            "span": [
              1,
              1
            ]
          }
        ]
      }
    }
  }
}
