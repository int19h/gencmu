{
  "description": "Constant references precede feature semantics.",
  "grammar": "%features f\n%conditions \"x\" ∈ $.value.split($E), $MISSING = \"x\"\n%const $E \"\"\n%rule text \"a\"",
  "input": "a",
  "expect": {
    "error": "grammar",
    "message": "$MISSING is not defined in stage main",
    "where": {
      "document": "main.md",
      "line": 3,
      "column": 1
    }
  }
}
