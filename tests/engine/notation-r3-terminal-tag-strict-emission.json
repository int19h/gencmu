{
  "description": "Strict restoration preserves a captured tag terminal for emission.",
  "grammar": "%rule text $x:A\n%emits $x ::($x.without-elision.value = \"a\" ⟹ Out)\n%rule family A",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "main",
          "output": [
            {
              "tags": [
                "Out"
              ],
              "value": "a"
            }
          ]
        }
      ]
    }
  }
}
