{
  "description": "A concatenation of closed strings can define a constant.",
  "grammar": "%const $A \"a\" ++ \"b\"\n%const $B $A ++ \"c\"\n%rule text $B",
  "input": "a",
  "expect": {
    "result": {
      "ok": true
    }
  },
  "tokens": [
    {
      "text": "a",
      "tags": [],
      "value": "abc"
    }
  ]
}
