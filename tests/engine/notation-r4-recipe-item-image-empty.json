{
  "description": "Engine §11.3 joins empty and nonempty literals with ++ in an item image recipe.",
  "grammar": "%const $S \"b\"\n%rule text $a:\"x\"\n%emits $a :- \"\" ++ \"\" ++ \"a\"",
  "input": "x",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "main",
          "output": [
            {
              "value": "x",
              "image": "a"
            }
          ]
        }
      ]
    }
  }
}
