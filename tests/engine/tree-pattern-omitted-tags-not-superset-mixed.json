{
  "description": "An omitted terminal exposes singleton tags to patterns. The empty helper keeps its empty constituent tags after reconstruction (engine §4.1 and §10).",
  "grammar": "%ambiguity-resolution late-elision\n%rule text $x:r %conditions $x.tags = ∅, ($x ≅ #(A T<¬T ¬U>) ∨ $x ≅ #(A OTHER OTHER [OTHER]))\n\n%rule r :: ∅ | (A [+T]) | (A [+OTHER] [+OTHER]) | (A [+OTHER] [+OTHER] [+OTHER])\n",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "parses": [
    {
      "options": {
        "elisionOnly": false
      },
      "expect": {
        "result": {
          "ok": true,
          "tree": {
            "children": [
              {
                "rule": "r",
                "tags": [],
                "children": [
                  {
                    "terminal": "A"
                  },
                  {
                    "kind": "elided",
                    "terminal": "OTHER"
                  },
                  {
                    "kind": "elided",
                    "terminal": "OTHER"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "options": {
        "elisionOnly": true
      },
      "expect": {
        "result": {
          "ok": true,
          "tree": {
            "children": [
              {
                "rule": "r",
                "tags": [],
                "children": [
                  {
                    "terminal": "A"
                  },
                  {
                    "kind": "elided",
                    "terminal": "OTHER"
                  },
                  {
                    "kind": "elided",
                    "terminal": "OTHER"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
