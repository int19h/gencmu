{
  "description": "A check message rejects value followed by verbatim-text.",
  "grammar": "%rule text \"a\"\n%check c #·text\n%warning $.value.verbatim-text",
  "input": "a",
  "expect": {
    "error": "grammar",
    "message": "a check message reads only $",
    "where": {
      "document": "main.md",
      "line": 5,
      "column": 10
    }
  }
}
