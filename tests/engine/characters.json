          {
            "kind": "token",
            "terminal": "'\\p{White_Space}'"
          },
          {
            "kind": "token",
            "terminal": "'0'..'9'"
          },
          {
            "kind": "token",
            "terminal": "'é'"
          }
        ]
      }
    }
  }
}
