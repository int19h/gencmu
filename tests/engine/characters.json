{
  "description": "The first stage reads one token per code point, tagged with the character and, weakly, its class (engine §1).",
  "grammar": "text ≔ \"x\" \"space\" \"digit\" \"é\" ;",
  "input": "x 7é",
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "kind": "rule",
        "rule": "text",
        "children": [
          {
            "kind": "token",
            "terminal": "x"
          },
          {
            "kind": "token",
            "terminal": "space"
          },
          {
            "kind": "token",
            "terminal": "digit"
          },
          {
            "kind": "token",
            "terminal": "é"
          }
        ]
      }
    }
  }
}
