{
  "description": "Every Pattern_Syntax value normalizes aliases through terminals, tests, patterns, conditions, filters, and caller tags.",
  "grammar": "%rule text r0\n%rule r0 $x:_Pattern_Syntax<_Pattern_Syntax>\n%conditions $x ≅ #_Pattern_Syntax<_Pattern_Syntax>, _Pattern_Syntax ⊆ $x.tags\n%emits $x :: $x.tags ∩ _Pattern_Syntax",
  "tokens": [
    {
      "text": "x",
      "value": "different",
      "tags": [
        "_Pat_Syn",
        "_Pattern_Syntax"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "tags": [
                "_Pattern_Syntax"
              ]
            }
          ]
        }
      ],
      "tree": {
        "children": [
          {
            "rule": "r0",
            "children": [
              {
                "terminal": "_Pattern_Syntax"
              }
            ],
            "tags": [
              "_Pattern_Syntax"
            ]
          }
        ]
      }
    }
  }
}
