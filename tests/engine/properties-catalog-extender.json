{
  "description": "Every Extender value normalizes aliases through terminals, tests, patterns, conditions, filters, and caller tags.",
  "grammar": "%rule text r0\n%rule r0 $x:_Extender<_Extender>\n%conditions $x ≅ #_Extender<_Extender>, _Extender ⊆ $x.tags\n%emits $x :: $x.tags ∩ _Extender",
  "tokens": [
    {
      "text": "x",
      "value": "different",
      "tags": [
        "_Ext",
        "_Extender"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "tags": [
                "_Extender"
              ]
            }
          ]
        }
      ],
      "tree": {
        "children": [
          {
            "rule": "r0",
            "children": [
              {
                "terminal": "_Extender"
              }
            ],
            "tags": [
              "_Extender"
            ]
          }
        ]
      }
    }
  }
}
