{
  "description": "Whole and prefix requests keep their different endpoints (engine §4 and §10).",
  "grammar": "%rule text $x:candidate %conditions $x.without-elision.begins(rival), ¬($x.without-elision.matches(rival))\n\n%rule candidate (X [+T] Y [+U])\n%rule rival (X [+T])",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ],
      "value": "x"
    },
    {
      "text": "y",
      "tags": [
        "Y"
      ],
      "value": "y"
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
