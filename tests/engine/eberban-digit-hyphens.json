{
  "description": "In the eberban/refgram pipeline, a hyphen on each side of a digit is a misplaced hyphen at a word boundary, so each carries hyphen-misplaced. The case names no rule, because the grammar does not fix which node holds such a hyphen.",
  "documents": {
    "pipeline.md": "```jbogenbau\n%include \"../grammars/eberban/refgram/pipeline.md\"\n```\n"
  },
  "pipelineDocument": "pipeline.md",
  "input": "mi -1- bjan",
  "expect": {
    "result": {
      "ok": true,
      "warnings": [
        {
          "stage": "forms",
          "span": [
            3,
            4
          ],
          "source": [
            3,
            4
          ],
          "code": "hyphen-misplaced"
        },
        {
          "stage": "forms",
          "span": [
            5,
            6
          ],
          "source": [
            5,
            6
          ],
          "code": "hyphen-misplaced"
        }
      ]
    }
  }
}
