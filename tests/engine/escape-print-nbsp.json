{
  "description": "A whitespace escape can use a core abbreviation. The canonical call name reloads with the same instance key (engine §9.1).",
  "grammar": "%ambiguity-resolution greedy\n%rule one(@X) @X\n%rule text one(\"‹U+00A0›\")\n%extend-rule one(\"‹NBSP›\") \"z\"",
  "input": "z",
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "rule": "text",
        "children": [
          {
            "rule": "one(\"‹NBSP›\")"
          }
        ]
      }
    }
  }
}
