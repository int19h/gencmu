{
  "description": "In the eberban/refgram pipeline, a hyphen inside a unit of a spelling quote carries hyphen-misplaced.",
  "documents": {
    "pipeline.md": "```jbogenbau\n%include \"../grammars/eberban/refgram/pipeline.md\"\n```\n"
  },
  "pipelineDocument": "pipeline.md",
  "input": "a ce b-u cei",
  "expect": {
    "result": {
      "ok": true
    },
    "warnings": [
      {
        "stage": "forms",
        "feature": "hyphen-misplaced",
        "rule": "misplaced-hyphen",
        "span": [
          6,
          7
        ],
        "source": [
          6,
          7
        ]
      }
    ]
  }
}
