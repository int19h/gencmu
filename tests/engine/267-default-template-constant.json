{
  "description": "A template default from a constant argument contributes only to the emitted value.",
  "grammar": "%const $END \"jie\"\n%rule pair(@Word)\n  \"t\" [+JI ≝ @Word]\n%emits $\n%rule text = pair($END)",
  "input": "t",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "value": "tjie",
              "image": "t"
            }
          ]
        }
      ]
    }
  }
}
