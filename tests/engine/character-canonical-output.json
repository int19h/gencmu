{
  "description": "Stage zero stores Unicode category tags, with _White_Space on the tab. Forwarded character tokens retain these tags rather than character tags (engine §1, docs/output.md).",
  "grammar": "%rule text [{c}]\n%rule c \"a\" | \"́\" | \"'\" | \"‹U+005C›\" | \"\" | \"‹U+0009›\" | \"e\" %emits $\n",
  "input": "á'\\\té",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "verdict": "unique",
          "output": [
            {
              "text": "a",
              "tags": [
                "_L",
                "_Ll"
              ]
            },
            {
              "text": "́",
              "tags": [
                "_M",
                "_Mn"
              ]
            },
            {
              "text": "'",
              "tags": [
                "_P",
                "_Po"
              ]
            },
            {
              "text": "\\",
              "tags": [
                "_P",
                "_Po"
              ]
            },
            {
              "text": "",
              "tags": [
                "_C",
                "_Co"
              ]
            },
            {
              "text": "\t",
              "tags": [
                "_C",
                "_Cc",
                "_White_Space"
              ]
            },
            {
              "text": "é",
              "tags": [
                "_L",
                "_Ll"
              ],
              "value": "e",
              "source": [
                6,
                7
              ]
            },
            {
              "text": "é",
              "value": "́",
              "image": "́",
              "source": [
                6,
                7
              ],
              "tags": [
                "_M",
                "_Mn"
              ]
            }
          ]
        }
      ]
    }
  }
}
