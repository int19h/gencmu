{
  "description": "The output writes a character tag in its canonical spelling: the character itself, or \\u{h…} for a control character, a nonspacing mark, a private-use character, the quote and the backslash. A character token carries its character tag and nothing else (engine §1, docs/output.md).",
  "grammar": "%rule text [{c}]\n%rule c \"a\" | \"́\" | \"'\" | $_005C | \"\" | $_0009 | \"é\" %emits $\n",
  "input": "á'\\\té",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "verdict": "unique",
          "output": [
            {
              "text": "a",
              "tags": [
                "_L",
                "_Ll"
              ]
            },
            {
              "text": "́",
              "tags": [
                "_M",
                "_Mn"
              ]
            },
            {
              "text": "'",
              "tags": [
                "_P",
                "_Po"
              ]
            },
            {
              "text": "\\",
              "tags": [
                "_P",
                "_Po"
              ]
            },
            {
              "text": "",
              "tags": [
                "_C",
                "_Co"
              ]
            },
            {
              "text": "\t",
              "tags": [
                "_C",
                "_Cc",
                "_White_Space"
              ]
            },
            {
              "text": "é",
              "tags": [
                "_L",
                "_Ll"
              ]
            }
          ]
        }
      ]
    }
  }
}
