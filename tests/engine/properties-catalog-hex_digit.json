{
  "description": "Every Hex_Digit value normalizes aliases through terminals, tests, patterns, conditions, filters, and caller tags.",
  "grammar": "%rule text r0\n%rule r0 $x:_Hex_Digit<_Hex_Digit>\n%conditions $x ≅ #_Hex_Digit<_Hex_Digit>, _Hex_Digit ⊆ $x.tags\n%emits $x :: $x.tags ∩ _Hex_Digit",
  "tokens": [
    {
      "text": "x",
      "value": "different",
      "tags": [
        "_Hex",
        "_Hex_Digit"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "output": [
            {
              "tags": [
                "_Hex_Digit"
              ]
            }
          ]
        }
      ],
      "tree": {
        "children": [
          {
            "rule": "r0",
            "children": [
              {
                "terminal": "_Hex_Digit"
              }
            ],
            "tags": [
              "_Hex_Digit"
            ]
          }
        ]
      }
    }
  }
}
