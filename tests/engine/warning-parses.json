              0,
              1
            ],
            "source": [
              0,
              1
            ]
          }
        ],
        "brackets": "a"
      }
    },
    {
      "options": {},
      "expect": {
        "result": {
          "ok": true
        },
        "warnings": [],
        "brackets": "a"
      }
    }
  ]
