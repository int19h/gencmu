{
  "description": "A check rejects incompatible comparison types and an empty split delimiter.",
  "grammar": "%const $E \"\"\n%const $P #·text\n%rule text \"a\"\n%check bad #·text\n%conditions $.value ∈ $P, $.split($E) = $.split(\"b\")\n%warning \"bad\"",
  "input": "a",
  "expect": {
    "error": "grammar"
  }
}
