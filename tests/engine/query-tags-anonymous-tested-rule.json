{
  "description": "An explicit query keeps tested rule tags outside checks.",
  "grammar": "%rule text $x:A\n%conditions $x.parse(r<T>), $x.parse(r<T>).tags = T\n%rule r A :: T",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "options": {
    "features": [
      "same"
    ]
  },
  "expect": {
    "result": {
      "ok": true
    }
  }
}
