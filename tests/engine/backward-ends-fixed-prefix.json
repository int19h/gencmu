{
  "description": "A suffix target sees the preceding tokens of the whole window. (Engine §4.4.)",
  "grammar": "%rule text A B\n%conditions $.ends(tail)\n%rule tail B\n%conditions $.preceding-tokens.value = \"a\"",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    },
    {
      "text": "b",
      "tags": [
        "B"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
