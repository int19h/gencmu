  "grammar": "%rule text $x(A)\n%conditions \"a\" ∉ words($x) ∧ \"a\\u{9}b\" ∈ words($x)",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "A"
      ],
      "phonemes": "a\tb"
    }
  ],
