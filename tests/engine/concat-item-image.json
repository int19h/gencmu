{
  "description": "An emission-item image recipe joins captured values without replacing the emitted value (engine §11.3).",
  "grammar": "%rule text $a:\"a\" $b:\"b\" %emits $ :- $a.value ++ \"-\" ++ $b.value",
  "input": "ab",
  "expect": {
    "result": {
      "ok": true,
      "stages": [
        {
          "name": "main",
          "output": [
            {
              "value": "ab",
              "image": "a-b"
            }
          ]
        }
      ]
    }
  }
}
