{
  "description": "A named capture reads the combined value of a grouped string-constant definition (engine §2, §10).",
  "grammar": "%const $JOIN-1 (\"a\" ++ \"b\")\n%rule text $x:$JOIN-1 %conditions $x.value = \"ab\" %emits",
  "tokens": [
