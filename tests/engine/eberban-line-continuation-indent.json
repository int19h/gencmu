{
  "description": "In the eberban/refgram pipeline, a hyphen before a line break takes the spaces that start the next line, so the word continues as bjan, with the warning for a hyphen before a final sonorant.",
  "documents": {
    "pipeline.md": "```jbogenbau\n%include \"../grammars/eberban/refgram/pipeline.md\"\n```\n"
  },
  "pipelineDocument": "pipeline.md",
  "input": "a mi bja-\n  n",
  "expect": {
    "result": {
      "ok": true
    },
    "warnings": [
      {
        "stage": "forms",
        "feature": "hyphen-misplaced",
        "rule": "misplaced-hyphen",
        "span": [
          8,
          9
        ],
        "source": [
          8,
          12
        ]
      }
    ]
  }
}
