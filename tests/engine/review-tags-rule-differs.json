{
  "description": "A whole-candidate tree guard can define constituent tags.",
  "grammar": "%rule text A\n%tags ($ ≇ @(B)) ⟹ X",
  "tokens": [
    {
      "text": "a",
      "tags": [
        "A"
      ]
    }
  ],
  "expect": {
    "result": {
      "ok": true,
      "tree": {
        "tags": [
          "X"
        ]
      }
    }
  }
}
