{
  "description": "A selected route establishes absence for every nested group that it excludes.",
  "grammar": "%rule text ((X & ($x(Y) ≻ V)) ≻ Z W)\n%tags ∅\n%conditions $x",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ]
    }
  ],
  "expect": {
    "error": "rejected",
    "result": {
      "error": {
        "kind": "rejected"
      }
    }
  }
}
