{
  "description": "A rival omission keeps the terminator tag for its own test (engine §4 and §10).",
  "grammar": "%rule text $x:candidate %conditions $x.without-elision.matches(rival)\n\n%rule candidate (X [+T])\n%rule rival (X [+T<T>])",
  "tokens": [
    {
      "text": "x",
      "tags": [
        "X"
      ],
      "value": "x"
    }
  ],
  "expect": {
    "result": {
      "ok": true
    }
  }
}
