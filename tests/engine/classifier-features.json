  "grammar": "%classifier lex g? \"mi\" ∈ KOhA ¬h? \"do\" ∈ KOhA\n\n\n%rule text [{word}]\n%rule word v! $w:W :: (Tag-w ∪ $w.value.classify(lex)) %emits $\n\n",
  "tokens": [
    {
