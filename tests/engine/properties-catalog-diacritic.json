  "grammar": "%rule text r0\n%rule r0 $x:_Diacritic<_Diacritic>\n%conditions $x ≅ #_Diacritic<_Diacritic>, _Diacritic ⊆ $x.tags\n%emits $x :: $x.tags ∩ _Diacritic",
