{
  "description": "⇒ $ emits the whole constituent, with tags of its own, and ⇒ $ <> erases it (engine §9).",
  "document": "# A document\n\nSome prose.\n\n```ebnf\na ≔ A ⇒ $ <\"X\"> ; b ≔ B ⇒ $ <> ;\n```\n",
  "expect": {
    "dom": {
      "rules": [
        {
          "emit": {
            "items": [
              {
                "capture": "",
                "tags": {
                  "literal": "X"
                }
              }
            ]
          }
        },
        {
          "emit": {
            "items": [
              {
                "capture": "",
                "erase": true
              }
            ]
          }
        }
      ]
    }
  }
}
