{
  "description": "A reference, a tag literal or a phoneme tag followed by = and a string is a tested symbol. The test binds tighter than ..., an optional or a capture can hold one, layout can stand before the test, and the string keeps its apostrophes and periods (engine §9).",
  "document": "```jbogenbau\n%rule text $l(LE=\"la\") ~zo=\"zo\" /a/=\"a\" UI=\"ui\" ... [KU =\"ku\"] BY=\"broda.bu\" LE=\"la'i\"\n```\n",
  "expect": {
    "dom": {
      "rules": [
        {
          "alternatives": [
            {
              "expr": {
                "seq": [
                  {
                    "capture": "l",
                    "expr": {
                      "test": "=",
                      "value": {
                        "string": "la"
                      },
                      "expr": {
                        "ref": "LE"
                      }
                    }
                  },
                  {
                    "test": "=",
                    "value": {
                      "string": "zo"
                    },
                    "expr": {
                      "terminal": "zo"
                    }
                  },
                  {
                    "test": "=",
                    "value": {
                      "string": "a"
                    },
                    "expr": {
                      "terminal": "/a/"
                    }
                  },
                  {
                    "repeat": {
                      "test": "=",
                      "value": {
                        "string": "ui"
                      },
                      "expr": {
                        "ref": "UI"
                      }
                    },
                    "min": 1
                  },
                  {
                    "optional": {
                      "test": "=",
                      "value": {
                        "string": "ku"
                      },
                      "expr": {
                        "ref": "KU"
                      }
                    }
                  },
                  {
                    "test": "=",
                    "value": {
                      "string": "broda.bu"
                    },
                    "expr": {
                      "ref": "BY"
                    }
                  },
                  {
                    "test": "=",
                    "value": {
                      "string": "la'i"
                    },
                    "expr": {
                      "ref": "LE"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
