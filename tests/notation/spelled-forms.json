{
  "description": "A reference, a string or a phoneme tag followed by a spelling in backticks is a spelled symbol; the spelling binds tighter than ..., an optional or a capture can hold one, layout may stand before the spelling, and a spelling keeps its apostrophes and periods (engine §9).",
  "document": "```jbogenbau\n%rule text $l(LE`la`) \"zo\"`zo` /a/`a` UI`ui` ... [KU `ku`] BY`broda.bu` LE`la'i`\n```\n",
  "expect": {
    "dom": {
      "rules": [
        {
          "alternatives": [
            {
              "expr": {
                "seq": [
                  {
                    "capture": "l",
                    "expr": {
                      "spelling": "la",
                      "expr": {
                        "ref": "LE"
                      }
                    }
                  },
                  {
                    "spelling": "zo",
                    "expr": {
                      "terminal": "zo"
                    }
                  },
                  {
                    "spelling": "a",
                    "expr": {
                      "terminal": "/a/"
                    }
                  },
                  {
                    "repeat": {
                      "spelling": "ui",
                      "expr": {
                        "ref": "UI"
                      }
                    },
                    "min": 1
                  },
                  {
                    "optional": {
                      "spelling": "ku",
                      "expr": {
                        "ref": "KU"
                      }
                    }
                  },
                  {
                    "spelling": "broda.bu",
                    "expr": {
                      "ref": "BY"
                    }
                  },
                  {
                    "spelling": "la'i",
                    "expr": {
                      "ref": "LE"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
