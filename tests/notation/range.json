{
  "description": "A range holds two scalar-string endpoints, and a capture can wrap it. The DOM preserves decoded strings and user constant references.",
  "document": "```jbogenbau\n%rule a (\"a\"..\"z\" \"a\"..\"z\" $c:\"̀\"..\"ͯ\")\n```\n",
  "expect": {
    "dom": {
      "format": 40,
      "rules": [
        {
          "alternatives": [
            {
              "expr": {
                "seq": [
                  {
                    "range": [
                      {
                        "string": "a"
                      },
                      {
                        "string": "z"
                      }
                    ]
                  },
                  {
                    "range": [
                      {
                        "string": "a"
                      },
                      {
                        "string": "z"
                      }
                    ]
                  },
                  {
                    "capture": "c",
                    "expr": {
                      "range": [
                        {
                          "string": "̀"
                        },
                        {
                          "string": "ͯ"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
