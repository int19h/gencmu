        {
          "alternatives": [
            {
              "expr": {
                "seq": [
                  {
                    "optional": {
                      "ref": "K"
                    },
                    "elidable": true
                  },
                  {
                    "optional": {
                      "expr": {
                        "ref": "K"
                      },
                      "test": "=",
                      "value": {
                        "string": "x"
                      }
                    },
                    "elidable": true
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "cacheMisses": true
}
