{
  "description": "Tags on a rule's name apply to all its alternatives (engine §9).",
  "document": "# A document\n\nSome prose.\n\n```jbogenbau\n%rule cmavo :: (Cmavo ∪ $w.tags(lexicon)) | $w:body\n```\n",
  "expect": {
    "dom": {
      "rules": [
        {
          "name": "cmavo",
          "tags": {
            "union": [
              {
                "tag": "Cmavo"
              },
              {
                "method": "tags",
                "receiver": {
                  "capture": "w"
                },
                "args": [
                  {
                    "rule": "lexicon"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
