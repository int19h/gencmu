{
  "description": "Supplied notation values cover names that cannot contain uppercase K in the bundled notation.",
  "cases": [
    {
      "id": "canonical-value-capture-ascii",
      "description": "A supplied notation gives this semantic name its token value.",
      "aliases": [
        {
          "spelling": "$xK",
          "value": "$x",
          "tags": [
            "Capture"
          ]
        }
      ],
      "document": "```jbogenbau\n%rule text $xK:\"a\"\n%conditions $xK ⟹ $xK.value = \"a\", $xK.value = \"a\", $xK ≅ #\"a\"\n%emits $xK\n%rule attached $xK:\"a\" $y:\"b\" %emits ($xK) $y\n```",
      "expect": {
        "dom": {
          "rules": [
            {
              "alternatives": [
                {
                  "expr": {
                    "capture": "x"
                  }
                }
              ],
              "conditions": [
                {
                  "if": {
                    "captured": "x"
                  },
                  "then": {
                    "left": {
                      "receiver": {
                        "capture": "x"
                      }
                    }
                  }
                },
                {
                  "left": {
                    "receiver": {
                      "capture": "x"
                    }
                  }
                },
                {
                  "left": {
                    "capture": "x"
                  }
                }
              ],
              "emit": {
                "items": [
                  {
                    "capture": "x"
                  }
                ]
              }
            },
            {
              "alternatives": [
                {
                  "expr": {
                    "seq": [
                      {
                        "capture": "x"
                      },
                      {
                        "capture": "y"
                      }
                    ]
                  }
                }
              ],
              "emit": {
                "items": [
                  {
                    "capture": "y",
                    "before": [
                      "x"
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "canonical-value-method-ascii",
      "description": "A supplied notation gives this semantic name its token value.",
      "aliases": [
        {
          "spelling": "methodK",
          "value": "matches",
          "tags": [
            "Identifier",
            "Lowercase-Name"
          ]
        }
      ],
      "document": "```jbogenbau\n%rule text $x:\"a\" %conditions $x.methodK(rK)\n%rule rK \"a\"\n```",
      "expect": {
        "dom": {
          "rules": [
            {
              "conditions": [
                {
                  "method": "matches",
                  "args": [
                    {
                      "rule": "rK"
                    }
                  ]
                }
              ]
            },
            {
              "name": "rK"
            }
          ]
        }
      }
    },
    {
